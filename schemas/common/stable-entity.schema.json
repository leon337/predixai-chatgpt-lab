{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predixai.example/schemas/common/stable-entity.schema.json",
  "type": "object",
  "required": ["id", "slug", "version", "status"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Z]{3}-[0-9]{4,6}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"type": "string"},
    "position": {"type": ["integer", "null"], "minimum": 0}
  }
}
