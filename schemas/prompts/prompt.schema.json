{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predixai.example/schemas/prompts/prompt.schema.json",
  "type": "object",
  "required": ["id", "slug", "version", "status", "category", "purpose", "inputs", "output_schema", "supported_surfaces", "allowed_tools", "forbidden_actions", "success_criteria", "test_cases"],
  "properties": {
    "id": {"type": "string", "pattern": "^PRM-[0-9]{4}$"},
    "status": {"enum": ["DRAFT", "IN_TESTING", "VALIDATED", "DEPRECATED", "ARCHIVED"]},
    "category": {"enum": ["SYSTEM", "MISSION", "TOOL", "EVALUATION", "RECOVERY", "SECURITY"]},
    "test_cases": {"type": "array", "minItems": 3},
    "supported_surfaces": {"type": "array", "minItems": 1},
    "allowed_tools": {"type": "array"},
    "forbidden_actions": {"type": "array"},
    "success_criteria": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
