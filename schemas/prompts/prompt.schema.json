{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predixai.example/schemas/prompts/prompt.schema.json",
  "title": "Versioned prompt contract",
  "type": "object",
  "required": [
    "id", "slug", "version", "status", "category", "purpose", "inputs", "expected_output",
    "output_schema", "supported_surfaces", "allowed_tools", "forbidden_actions", "success_criteria",
    "test_cases", "limitations", "origin", "content_hash", "security_review", "controlled_executions", "changelog"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^PRM-[0-9]{4}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["DRAFT", "IN_TESTING", "VALIDATED", "DEPRECATED", "ARCHIVED"]},
    "category": {"enum": ["SYSTEM", "MISSION", "TOOL", "EVALUATION", "RECOVERY", "SECURITY"]},
    "purpose": {"type": "string", "minLength": 1},
    "inputs": {"type": "object"},
    "expected_output": {"type": "string", "minLength": 1},
    "output_schema": {"type": "object"},
    "supported_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "allowed_tools": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "forbidden_actions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "success_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "variation_id", "input_variant", "expected_assertions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "variation_id": {"type": "string", "minLength": 1},
          "input_variant": {"type": "string", "minLength": 1},
          "expected_assertions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        },
        "additionalProperties": false
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "origin": {
      "type": "object",
      "required": ["source", "author", "reviewed"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "reviewed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "security_review": {
      "type": "object",
      "required": ["status", "reviewer", "reviewed_at"],
      "properties": {
        "status": {"enum": ["NOT_REVIEWED", "PASS", "FAIL"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"}
      },
      "additionalProperties": false
    },
    "controlled_executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run_id", "variation_id", "surface", "result", "executed_at"],
        "properties": {
          "run_id": {"type": "string", "minLength": 1},
          "variation_id": {"type": "string", "minLength": 1},
          "surface": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL", "BLOCKED"]},
          "executed_at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": false
      }
    },
    "validation_summary": {
      "type": "object",
      "required": ["controlled_execution_count", "distinct_input_variations", "all_executions_passed"],
      "properties": {
        "controlled_execution_count": {"type": "integer", "minimum": 0},
        "distinct_input_variations": {"type": "integer", "minimum": 0},
        "all_executions_passed": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "changelog": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "VALIDATED"}}, "required": ["status"]},
      "then": {
        "required": ["validation_summary"],
        "properties": {
          "test_cases": {"minItems": 3},
          "controlled_executions": {"minItems": 3, "items": {"properties": {"result": {"const": "PASS"}}}},
          "origin": {"properties": {"reviewed": {"const": true}}},
          "security_review": {"properties": {"status": {"const": "PASS"}, "reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}}},
          "validation_summary": {"properties": {"controlled_execution_count": {"minimum": 3}, "distinct_input_variations": {"minimum": 3}, "all_executions_passed": {"const": true}}}
        }
      }
    }
  ],
  "additionalProperties": false,
  "x-semantic-validator": "scripts/contract_semantics.py#validate_prompt_semantics",
  "x-semantic-invariants": [
    "VALIDATED prompts have at least three distinct variation_id values",
    "execution variation_id values reference declared test cases",
    "validation_summary is derived from controlled_executions"
  ]
}
