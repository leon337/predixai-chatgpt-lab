{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://predixai.example/schemas/assessments/assessment.schema.json",
  "type": "object",
  "required": ["id", "attempt_id", "rubric_version", "criterion_scores", "eliminatory_checks", "total_score", "result"],
  "properties": {
    "id": {"type": "string", "pattern": "^EVL-[0-9]{4,6}$"},
    "attempt_id": {"type": "string"},
    "rubric_version": {"type": "string"},
    "criterion_scores": {"type": "array", "minItems": 1},
    "eliminatory_checks": {
      "type": "object",
      "required": ["valid_evidence", "own_explanation", "security_compliant", "not_fabricated"],
      "additionalProperties": {"type": "boolean"}
    },
    "total_score": {"type": "number", "minimum": 0, "maximum": 100},
    "result": {"enum": ["NOT_COMPLETED", "REMEDIATION", "MASTERED", "MASTERED_EXCELLENCE"]}
  }
}
